rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // Imágenes de servicios y logos organizados por businessId
    match /businesses/{businessId}/{allPaths=**} {
      // Lectura pública para que se vean en la vitrina web
      allow read: if true;
      // Solo el usuario autenticado puede subir imágenes (máx 5MB y sólo tipo imagen)
      allow write: if request.auth != null
                   && request.resource.size < 5 * 1024 * 1024
                   && request.resource.contentType.matches('image/.*');
    }
  }
}
