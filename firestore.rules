rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ==========================================
    // COLECCIÓN: users (Perfil del profesional)
    // ==========================================
    match /users/{userId} {
      // Cada usuario solo puede leer y modificar su propio documento de perfil
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // ==========================================
    // COLECCIÓN: businesses (Negocios / Vitrinas)
    // ==========================================
    match /businesses/{businessId} {
      // 1. Lectura pública para cualquier visitante (necesario para la vitrina /b/:businessSlug)
      allow read: if true;

      // 2. Creación, Actualización y Borrado: Permitido para cualquier usuario autenticado (Super Admin y dueños)
      allow create, update, delete: if request.auth != null;

      // ==========================================
      // SUBCOLECCIÓN: services (Servicios del negocio)
      // ==========================================
      match /services/{serviceId} {
        // Lectura pública para la vitrina digital del negocio
        allow read: if true;

        // Escritura para cualquier usuario autenticado
        allow write: if request.auth != null;
      }

      // ==========================================
      // SUBCOLECCIÓN: quotes (Cotizaciones y Trabajos)
      // ==========================================
      match /quotes/{quoteId} {
        // Acceso para usuarios autenticados
        allow read, write: if request.auth != null;
      }
    }
  }
}
