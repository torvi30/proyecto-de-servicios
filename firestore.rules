rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ==========================================
    // COLECCIÓN: users (Perfil del profesional)
    // ==========================================
    match /users/{userId} {
      // Cada usuario solo puede leer y modificar su propio documento de perfil
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // ==========================================
    // COLECCIÓN: businesses (Negocios / Vitrinas)
    // ==========================================
    match /businesses/{businessId} {
      // 1. Lectura pública para cualquier visitante (necesario para la vitrina /b/:businessSlug)
      allow read: if true;

      // 2. Creación: El usuario debe estar autenticado y registrarse a sí mismo como ownerId
      allow create: if request.auth != null 
                    && request.resource.data.ownerId == request.auth.uid;

      // 3. Actualización y Borrado: Solo el dueño actual del negocio puede modificarlo
      allow update, delete: if request.auth != null 
                            && resource.data.ownerId == request.auth.uid;

      // ==========================================
      // SUBCOLECCIÓN: services (Servicios del negocio)
      // ==========================================
      match /services/{serviceId} {
        // Lectura pública para la vitrina digital del negocio
        allow read: if true;

        // Escritura/Creación/Edición/Borrado: Solo el dueño del negocio padre
        allow write: if request.auth != null 
                     && get(/databases/$(database)/documents/businesses/$(businessId)).data.ownerId == request.auth.uid;
      }

      // ==========================================
      // SUBCOLECCIÓN: quotes (Cotizaciones y Trabajos)
      // ==========================================
      match /quotes/{quoteId} {
        // Las cotizaciones contienen datos privados de clientes (teléfono, precios, estado)
        // Solo el dueño del negocio puede leerlas o gestionarlas
        allow read, write: if request.auth != null 
                           && get(/databases/$(database)/documents/businesses/$(businessId)).data.ownerId == request.auth.uid;
      }
    }
  }
}
